# Dependencies
node_modules/
**/node_modules/

# Build output
apps/dashboard/dist/
apps/dashboard/dist-server/
apps/dashboard/.vite/
apps/dashboard/.tsbuild-node/
**/*.tsbuildinfo

# Passenger registry database (runtime data — do not commit)
apps/dashboard/data/

# Environment secrets — never commit real values.
# `.env.*` (not just `.env`/`.env.local`/`.env.*.local`) so a locally-named
# variant like `.env.production` or `deploy.env` can't slip in by not
# matching the narrower patterns below; `.env.example` is explicitly
# un-ignored since it's the checked-in template.
.env
.env.local
.env.*.local
.env.*
!.env.example
deploy.env
*.env.local

# Private keys / certs / credential material — rotate immediately if any of
# these are ever found in history.
*.p8
*.pem
*.key
*credentials*.json
*license*.json

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
.venv/
venv/
*.egg-info/

# Editors
.DS_Store
*.swp
*.swo
.idea/
.vscode/settings.json

# Logs
*.log
npm-debug.log*

# OS
Thumbs.db

# Route-site video assets (large; copy locally from v2 or download at deploy)
apps/dashboard/public/route_site/*.mp4
apps/dashboard/public/route_site/dynamic/

# Offline Docker export (images + generated demo .env)
docker/dist/
