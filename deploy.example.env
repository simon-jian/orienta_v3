# ──────────────────────────────────────────────────────────────────────────────
# Orienta v3 — PRODUCTION deploy env
# Usage: docker compose --env-file deploy.example.env up -d
#
# Copy this file, fill in REAL secrets, and keep it out of git.
# Every value below is set to a safe production default.
# ──────────────────────────────────────────────────────────────────────────────

# Host port mappings (dashboard binds to loopback by default — TLS terminator in front)
HOST_BIND=127.0.0.1
HOST_PORT=5174

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Rotation: to rotate JWT_SECRET without an instant hard cutover (which
# invalidates every in-flight admin/passenger session), set the NEW value
# above and put the OLD value here (comma-separated if rotating more than
# once before the oldest is safe to drop) — still accepted for verification,
# never used to sign new tokens. Remove once 30 days (the longest session
# TTL) have passed since the rotation.
JWT_SECRET_PREVIOUS=

# Admin logins. Format: email:password,email2:password2
# Production: prefer scrypt hashes over plaintext. Generate a hash with:
#   node apps/dashboard/dist-server/server/scripts/hashAdminPassword.js 'your-password'
# then use:  admin@airchina.com:scrypt$<salt>$<hash>
ADMIN_CREDENTIALS=admin@airchina.com:replace-me

# Premium passenger seed accounts (optional). Same hash support as above.
# After first boot you can manage accounts via the admin API instead of env.
PAX_ACCOUNT_CREDENTIALS=

# Required in production: shared secret boarding-pass scan kiosks must send as
# the X-Kiosk-Secret header before POST /api/pax/scan mints a session. Unset
# leaves that endpoint open to anyone (fine for local dev only) — the server
# refuses to start in production without this set. Generate with:
#   openssl rand -hex 24
KIOSK_SCAN_SECRET=replace-with-openssl-rand-hex-24

# Optional per-admin overrides — every admin/ops/viewer credential in
# ADMIN_CREDENTIALS is unrestricted (every role inferred from an "ops"-prefix
# email, every tenant allowed) unless listed here.
#   ADMIN_ROLES: "email=role,email2=role2" (role: admin | ops | viewer)
#   ADMIN_TENANT_SCOPES: "email=tenant1|tenant2,email2=tenant3" — restricts
#     that admin to only the listed tenant(s); omit an email to leave it
#     unrestricted (needed for a single-tenant deploy like this one).
ADMIN_ROLES=
ADMIN_TENANT_SCOPES=

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to POST tourist-position (CORS).
# Leave empty to allow same-origin only. Use '*' ONLY for open kiosks.
TOURIST_ALLOWED_ORIGINS=

# ── PDR service ───────────────────────────────────────────────────────────────
# Deployed separately (see README.md) — service root only (no /api suffix).
# From Docker Compose, use host.docker.internal to reach a process on the host.
# Production refuses loopback (127.0.0.1/localhost) unless ALLOW_LOOPBACK_UPSTREAMS=1.
PDR_API_ORIGIN=http://host.docker.internal:8000
# ALLOW_LOOPBACK_UPSTREAMS=1

# ── Indoor map topology ───────────────────────────────────────────────────────
# Two supported modes (see README "Indoor map topology"):
#   A) Bundled tiles/POI: leave both UPSTREAM vars EMPTY and vendor assets into
#      repo-root indoor-map-tiles/ + indoor-map-api/ (NOT present in this image).
#   B) External map stack (required for a navigable deploy today).
# Do NOT use 127.0.0.1 here when running in Docker — that is the container itself.
INDOOR_MAP_UPSTREAM=http://host.docker.internal:7801
INDOOR_MAP_API_UPSTREAM=http://host.docker.internal:3001
VITE_LOCAL_AIRPORT_MAP=0

# ── Live flight data (FlightAware AeroAPI) ────────────────────────────────────
# Drives live gate/schedule resolution for passenger sessions AND the admin
# FIDS board (GET /api/fids/departures|arrivals). When empty, boards show
# "unconfigured" (no demo fallback). Get a key at https://flightaware.com/aeroapi/
FLIGHTAWARE_API_KEY=

# ── Web Push (VAPID) — optional; push routes return 503 when missing ──────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@orienta.ai

# Structured-log verbosity: debug | info | warn | error (P1-3)
LOG_LEVEL=info

# ── Multi-instance backends (P2-1 / P2-3) — OPTIONAL ──────────────────────────
# Leave BOTH empty for single-machine deploys: the server uses local SQLite +
# in-memory state (works out of the box). Set them only when running 2+ app
# instances behind a load balancer (HA / horizontal scale).
#
# Bring up the bundled Postgres + Redis with:  docker compose --profile scale up -d
# Then point the app at them (use a strong POSTGRES_PASSWORD + REDIS_PASSWORD):
#   DATABASE_URL=postgres://orienta:STRONG_PASSWORD@postgres:5432/orienta
#   REDIS_URL=redis://:STRONG_REDIS_PASSWORD@redis:6379
DATABASE_URL=
# Production refuses REDIS_URL without a password. Example:
#   REDIS_PASSWORD=STRONG_REDIS
#   REDIS_URL=redis://:STRONG_REDIS@redis:6379
REDIS_URL=
REDIS_PASSWORD=
# Credentials for the bundled postgres service (only used with --profile scale):
POSTGRES_USER=orienta
POSTGRES_PASSWORD=orienta
POSTGRES_DB=orienta

# ── Error tracking (P2-5) ─────────────────────────────────────────────────────
# Optional. Leave empty to disable (errors still go to structured logs).
# SENTRY_DSN powers the backend SDK at runtime.
# VITE_SENTRY_DSN is bake-time only (Vite inlines it during `npm run build`) —
# setting it in compose alone will NOT enable the browser SDK for an already-
# built image; rebuild with the build-arg / env present, or leave client Sentry off.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Defaults to NODE_ENV / Vite MODE when empty. NOTE: these are two SEPARATE
# vars, not one shared by both SDKs — Vite only exposes VITE_-prefixed vars to
# the browser build, so set both if you want environment/release tagging on
# both server- and client-reported errors.
SENTRY_ENVIRONMENT=
VITE_SENTRY_ENVIRONMENT=
# Optional release tag for grouping (e.g. git sha or version) — same
# server/client split as above.
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=
# Performance trace sampling 0..1 (default 0 = errors only).
SENTRY_TRACES_SAMPLE_RATE=

# ── Logging ────────────────────────────────────────────────────────────────────
# debug | info | warn | error (default: info)
LOG_LEVEL=info

# ── Multi-airport config (Model B: runtime-loaded YAML) ───────────────────────
# Directory containing airports/*.yaml + tenants/*.yaml, loaded at boot
# (server/config/loadConfig.ts). Defaults to ./config relative to the process
# working directory — override to point at an external mount if you keep
# per-deployment config outside the image.
AIRPORT_CONFIG_DIR=
# Which airport id (from the loaded YAML) is the default when a request/session
# doesn't otherwise specify one. Defaults to the first airport loaded.
DEFAULT_AIRPORT=PEK

# ── Misc ────────────────────────────────────────────────────────────────────────
# Distinguishes instances in logs / WS fan-out de-dup (P2-3). Auto-generated
# (random) when unset — set explicitly if you want stable, recognizable ids
# across restarts (e.g. "web-1", "web-2").
INSTANCE_ID=

# ── Multi-airport (Phase 0+) ──────────────────────────────────────────────────
# Default hub/tenant for the build. Read by src/config/client.ts; fall back to
# PEK / airchina when empty. Wiring of consumers lands in Phase 1.
VITE_DEFAULT_AIRPORT=PEK
VITE_ORIENTA_TENANT=airchina
# Server-side default terminal for POI lookups (indoor-map /api/poi?terminal=…).
DEFAULT_TERMINAL=T3E

# ── Misc ──────────────────────────────────────────────────────────────────────
ROUTE_SITE_DEFAULT_TENANT=airchina
