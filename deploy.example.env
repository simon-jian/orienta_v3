# ──────────────────────────────────────────────────────────────────────────────
# Orienta v3 — PRODUCTION deploy env
# Usage: docker compose --env-file deploy.example.env up -d
#
# Copy this file, fill in REAL secrets, and keep it out of git.
# Every value below is set to a safe production default — do NOT loosen the
# security flags (PAX_LEGACY_AUTH / ORIENTA_ALLOW_DEMO) for a real deployment.
# ──────────────────────────────────────────────────────────────────────────────

# Host port mappings
HOST_PORT=5174
PDR_HOST_PORT=10000

# ── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Admin logins. Format: email:password,email2:password2
# Production: prefer scrypt hashes over plaintext. Generate a hash with:
#   node apps/dashboard/dist-server/server/scripts/hashAdminPassword.js 'your-password'
# then use:  admin@airchina.com:scrypt$<salt>$<hash>
ADMIN_CREDENTIALS=admin@airchina.com:replace-me

# Premium passenger seed accounts (optional). Same hash support as above.
# After first boot you can manage accounts via the admin API instead of env.
PAX_ACCOUNT_CREDENTIALS=

# ── Security flags (KEEP THESE for production) ────────────────────────────────
PAX_LEGACY_AUTH=0       # require passenger session JWT (no pax.html impersonation)
ORIENTA_ALLOW_DEMO=0    # disable the built-in demo/demo admin login

# Comma-separated origins allowed to POST tourist-position (CORS).
# Leave empty to allow same-origin only. Use '*' ONLY for open kiosks/demos.
TOURIST_ALLOWED_ORIGINS=

# ── PDR service ───────────────────────────────────────────────────────────────
PDR_API_ORIGIN=http://orienta-pdr:10000

# ── Indoor map topology ───────────────────────────────────────────────────────
# Two supported modes (see README "Indoor map topology"):
#   A) Bundled tiles/POI: leave INDOOR_MAP_UPSTREAM / INDOOR_MAP_API_UPSTREAM EMPTY.
#      The server serves tiles from public/ and POI from the bundled JSON.
#   B) External map stack: point these at the running map server (7801) + API (3001).
INDOOR_MAP_UPSTREAM=
INDOOR_MAP_API_UPSTREAM=
VITE_LOCAL_AIRPORT_MAP=0

# ── Live flight data (FlightAware AeroAPI) ────────────────────────────────────
# Drives live gate/schedule resolution for passenger sessions (P1-7) and the
# /flight lookup routes. When empty, the static PEK demo schedule is used as a
# fallback. Get a key at https://flightaware.com/aeroapi/
FLIGHTAWARE_API_KEY=

# Structured-log verbosity: debug | info | warn | error (P1-3)
LOG_LEVEL=info

# ── Multi-instance backends (P2-1 / P2-3) — OPTIONAL ──────────────────────────
# Leave BOTH empty for single-machine deploys: the server uses local SQLite +
# in-memory state (works out of the box). Set them only when running 2+ app
# instances behind a load balancer (HA / horizontal scale).
#
# Bring up the bundled Postgres + Redis with:  docker compose --profile scale up -d
# Then point the app at them:
#   DATABASE_URL=postgres://orienta:orienta@postgres:5432/orienta
#   REDIS_URL=redis://redis:6379
DATABASE_URL=
REDIS_URL=
# Credentials for the bundled postgres service (only used with --profile scale):
POSTGRES_USER=orienta
POSTGRES_PASSWORD=orienta
POSTGRES_DB=orienta

# ── Error tracking (P2-5) ─────────────────────────────────────────────────────
# Optional. Leave empty to disable (errors still go to structured logs).
# SENTRY_DSN powers the backend SDK; VITE_SENTRY_DSN powers the browser SDK.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Defaults to NODE_ENV / Vite MODE when empty.
SENTRY_ENVIRONMENT=
# Optional release tag for grouping (e.g. git sha or version).
SENTRY_RELEASE=
# Performance trace sampling 0..1 (default 0 = errors only).
SENTRY_TRACES_SAMPLE_RATE=

# ── Multi-airport (Phase 0+) ──────────────────────────────────────────────────
# Default hub/tenant for the build. Read by src/config/client.ts; fall back to
# PEK / airchina when empty. Wiring of consumers lands in Phase 1.
VITE_DEFAULT_AIRPORT=PEK
VITE_ORIENTA_TENANT=airchina
# Server-side default terminal for POI lookups (indoor-map /api/poi?terminal=…).
DEFAULT_TERMINAL=T3E

# ── Misc ──────────────────────────────────────────────────────────────────────
ROUTE_SITE_DEFAULT_TENANT=airchina
