# Example env for `docker compose --env-file deploy.example.env up -d`
# Generate a real JWT_SECRET before any shared/staging deploy.

HOST_PORT=5174
PDR_HOST_PORT=10000

JWT_SECRET=replace-with-openssl-rand-hex-32
ADMIN_CREDENTIALS=admin@airchina.com:your-password
PAX_ACCOUNT_CREDENTIALS=premium@orienta.ai:your-password

PDR_API_ORIGIN=http://orienta-pdr:10000
PAX_LEGACY_AUTH=0
ORIENTA_ALLOW_DEMO=0

INDOOR_MAP_UPSTREAM=
INDOOR_MAP_API_UPSTREAM=
VITE_LOCAL_AIRPORT_MAP=0
ROUTE_SITE_DEFAULT_TENANT=airchina
