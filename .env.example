# ─── Orienta v3 — root environment template ───────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.
# Used by: docker compose --env-file .env up -d
# (Compose substitutes these into docker-compose.yml → container env.)

# Host bind/port for the dashboard (loopback by default — TLS terminator in front)
HOST_BIND=127.0.0.1
HOST_PORT=5174

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_SECRET_PREVIOUS=
ADMIN_CREDENTIALS=admin@airchina.com:YOUR_PASSWORD_HERE,ops@airchina.com:YOUR_OPS_PASSWORD_HERE
PAX_ACCOUNT_CREDENTIALS=premium@example.com:YOUR_PASSWORD_HERE
# Required in production (compose marks it required):
KIOSK_SCAN_SECRET=
ADMIN_ROLES=
ADMIN_TENANT_SCOPES=
TOURIST_ALLOWED_ORIGINS=

# ── FlightAware AeroAPI (live gate resolve + FIDS board) ─────────────────────
FLIGHTAWARE_API_KEY=YOUR_FLIGHTAWARE_KEY_HERE

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:ops@orienta.ai

# Public origin for passenger claim / arrival-share links (and SMS). Required
# behind a proxy or tunnel; phones cannot open localhost.
PUBLIC_BASE_URL=

# ── SMS (Twilio) — optional; invite SMS returns 503 when missing ─────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=

# ── Email (SMTP) — optional; invite email returns 503 when missing ───────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Orienta <ops@yourairline.com>

# ── PDR (separate repo: ../pedestrian_dead_reckoning) ────────────────────────
# Service root only — no trailing slash, no /api suffix.
# npm run (host): http://127.0.0.1:8000
# docker compose: http://host.docker.internal:8000  (production refuses loopback)
PDR_API_ORIGIN=http://host.docker.internal:8000

# ── Indoor map (Mode B — required for a navigable deploy today) ──────────────
# Mode A assets are NOT in this repo/image. In Docker use host.docker.internal
# (not 127.0.0.1 — that is the container itself).
INDOOR_MAP_UPSTREAM=http://host.docker.internal:7801
INDOOR_MAP_API_UPSTREAM=http://host.docker.internal:3001
VITE_LOCAL_AIRPORT_MAP=0
# ALLOW_LOOPBACK_UPSTREAMS=1

# ── Scale profile (optional) ─────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=
REDIS_PASSWORD=
POSTGRES_USER=orienta
POSTGRES_PASSWORD=orienta
POSTGRES_DB=orienta
