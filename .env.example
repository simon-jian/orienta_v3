# ─── Orienta v3 — environment template ──────────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.
# All values marked YOUR_*_HERE must be replaced before the server will start.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign admin JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Optional, comma-separated: previous JWT_SECRET value(s), still accepted for
# verification but never used to sign new tokens — set to the OLD value while
# rotating JWT_SECRET so in-flight sessions aren't all instantly invalidated.
JWT_SECRET_PREVIOUS=

# Comma-separated list of admin credentials: email:password,email2:password2
# Example: admin@airchina.com:supersecret,ops@airchina.com:anothersecret
ADMIN_CREDENTIALS=admin@airchina.com:YOUR_PASSWORD_HERE,ops@airchina.com:YOUR_OPS_PASSWORD_HERE

# Temporary local premium passenger accounts for development.
# Replace with a real account table/password hashing before production deployment.
PAX_ACCOUNT_CREDENTIALS=premium@example.com:YOUR_PASSWORD_HERE

# Required in production (dev: leave empty, POST /api/pax/scan stays open):
# shared secret boarding-pass scan kiosks must send as X-Kiosk-Secret.
# Generate with: openssl rand -hex 24
KIOSK_SCAN_SECRET=

# Optional per-admin overrides (default: every admin unrestricted to every
# tenant, role inferred from an "ops"-prefix email).
#   ADMIN_ROLES: "email=role,email2=role2" (role: admin | ops | viewer)
#   ADMIN_TENANT_SCOPES: "email=tenant1|tenant2" — restrict an admin to only
#     the listed tenant(s); omit an email to leave it unrestricted.
ADMIN_ROLES=
ADMIN_TENANT_SCOPES=

# ── FlightAware AeroAPI ───────────────────────────────────────────────────────
FLIGHTAWARE_API_KEY=YOUR_FLIGHTAWARE_KEY_HERE

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:ops@orienta.ai

# ── PDR service ──────────────────────────────────────────────────────────────
# Root URL of the Python PDR service — no trailing slash, no /api suffix.
# Local: start with `npm run pdr:dev` (from apps/dashboard) or `docker compose up orienta-pdr`
PDR_API_ORIGIN=http://127.0.0.1:10000

# ── Indoor map ────────────────────────────────────────────────────────────────
# Browser routes stay relative; backend proxies these to the local map stack.
INDOOR_MAP_UPSTREAM=http://127.0.0.1:7801
INDOOR_MAP_API_UPSTREAM=http://127.0.0.1:3001
# Set to 1 only if airport-map.html is checked out at the expected repo-relative path.
VITE_LOCAL_AIRPORT_MAP=0

# ── Frontend public vars (exposed to browser) ────────────────────────────────
VITE_INDOOR_MAP_URL=/indoor-map/airport-map.html
VITE_INDOOR_MAP_API_BASE=/indoor-map-api
VITE_INDOOR_MAP_TILE_URL=
VITE_INDOOR_MAP_SAME_ORIGIN=0

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5174
ROUTE_SITE_DEFAULT_TENANT=airchina

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to POST tourist-position (CORS).
# Empty = same-origin only. '*' = open (kiosk only).
TOURIST_ALLOWED_ORIGINS=
