# ─── Orienta v3 — root environment template ───────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.
# Used by: docker compose --env-file .env up -d
# (Compose substitutes these into docker-compose.yml → container env.)

# Host port for the dashboard
HOST_PORT=5174

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_SECRET_PREVIOUS=
ADMIN_CREDENTIALS=admin@airchina.com:YOUR_PASSWORD_HERE,ops@airchina.com:YOUR_OPS_PASSWORD_HERE
PAX_ACCOUNT_CREDENTIALS=premium@example.com:YOUR_PASSWORD_HERE
# Required in production (compose marks it required):
KIOSK_SCAN_SECRET=
ADMIN_ROLES=
ADMIN_TENANT_SCOPES=
TOURIST_ALLOWED_ORIGINS=

# ── FlightAware AeroAPI (live gate resolve + FIDS board) ─────────────────────
FLIGHTAWARE_API_KEY=YOUR_FLIGHTAWARE_KEY_HERE

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
VAPID_SUBJECT=mailto:ops@orienta.ai

# ── PDR (separate repo: ../pedestrian_dead_reckoning) ────────────────────────
# Service root only — no trailing slash, no /api suffix. Default local port 8000.
# Start with: cd apps/dashboard && npm run pdr:dev
# Also set PDR_ALLOWED_ORIGINS on the PDR service to this app's origin.
PDR_API_ORIGIN=http://127.0.0.1:8000

# ── Indoor map (Mode B — required for a navigable deploy today) ──────────────
# Mode A (bundled tiles at repo-root indoor-map-tiles / indoor-map-api) is NOT
# populated in this repo or its Docker image — leave these pointing at a running
# map stack unless you vendor those assets yourself.
INDOOR_MAP_UPSTREAM=http://127.0.0.1:7801
INDOOR_MAP_API_UPSTREAM=http://127.0.0.1:3001
VITE_LOCAL_AIRPORT_MAP=0

# ── Scale profile (optional) ─────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=
REDIS_PASSWORD=
POSTGRES_USER=orienta
POSTGRES_PASSWORD=orienta
POSTGRES_DB=orienta
