{
  "name": "orienta-dashboard",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && PORT=5175 node --env-file=.env dist-server/server/server.js",
    "pdr:dev": "cd ../../pdr_airchina && PORT=10000 python3 run.py",
    "build": "tsc -b && vite build",
