{
  "name": "orienta-dashboard",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && PORT=5175 node --env-file=.env dist-server/server/server.js",
    "pdr:dev": "cd ../../../pedestrian_dead_reckoning && uvicorn backend.app:app --reload --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node --env-file=.env dist-server/server/server.js",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src server",
    "lint:fix": "eslint src server --fix",
    "format": "prettier --write src server",
    "format:check": "prettier --check src server"
  },
  "dependencies": {
    "@sentry/node": "^10.62.0",
    "@sentry/react": "^10.62.0",
    "better-sqlite3": "^12.10.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.2.0",
    "http-proxy-middleware": "^3.0.0",
    "ioredis": "^5.11.1",
    "jose": "^5.3.0",
    "js-yaml": "^5.2.0",
    "leaflet": "^1.9.4",
    "pg": "^8.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.2",
    "web-push": "^3.6.7",
    "ws": "^8.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/web-push": "^3.6.3",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
