# ─── Required ────────────────────────────────────────────────────────────────
# Sign-in JWTs. Use: openssl rand -hex 32
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Optional, comma-separated: previous JWT_SECRET value(s), still accepted for
# verification but never used to sign new tokens. Set this to the OLD value
# when rotating JWT_SECRET so in-flight admin/passenger sessions aren't all
# instantly invalidated — remove it again once the longest session TTL (30
# days) has passed since the rotation.
JWT_SECRET_PREVIOUS=

# Comma-separated "email:password" pairs for admin logins.
# Production: prefer scrypt hashes over plaintext. Generate one with:
#   node dist-server/server/scripts/hashAdminPassword.js 'your-password'
# then use:  admin@airchina.com:scrypt$<salt>$<hash>
# Example (dev): admin@airchina.com:changeme,ops@airchina.com:changeme
ADMIN_CREDENTIALS=admin@yourairline.com:YOUR_PASSWORD_HERE

# Temporary local premium passenger accounts for development (seeds SQLite on first boot).
# After boot, manage accounts via the admin API (POST /api/pax/accounts) instead of env.
PAX_ACCOUNT_CREDENTIALS=premium@example.com:YOUR_PASSWORD_HERE

# Required in production (dev: leave empty, POST /api/pax/scan stays open):
# shared secret boarding-pass scan kiosks must send as X-Kiosk-Secret.
# Generate with: openssl rand -hex 24
KIOSK_SCAN_SECRET=

# Optional per-admin overrides (default: every admin unrestricted to every
# tenant, role inferred from an "ops"-prefix email — fine for a single-tenant
# deploy). See deploy.example.env for the full format.
ADMIN_ROLES=
ADMIN_TENANT_SCOPES=

# ─── FlightAware (required for live flight/FIDS data; omit → no flight data) ──
FLIGHTAWARE_API_KEY=YOUR_FLIGHTAWARE_API_KEY

# ─── VAPID Web Push (optional — push routes return 503 when missing) ─────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:ops@yourairline.com

# ─── PDR (pedestrian dead reckoning) proxy (optional) ────────────────────────
# Service root only — do NOT include /api suffix.
# Local `npm run`: 127.0.0.1 is fine (NODE_ENV≠production). Docker production
# refuses loopback unless ALLOW_LOOPBACK_UPSTREAMS=1 — use host.docker.internal.
PDR_API_ORIGIN=http://127.0.0.1:8000

# ─── Indoor map topology (see README "Indoor map topology") ──────────────────
# Mode A (bundled): leave both UPSTREAM vars EMPTY and place assets at
#   ../../indoor-map-tiles and ../../indoor-map-api (repo root — not in this image).
# Mode B (external, recommended): map server :7801 + POI API :3001.
# Local npm run can use 127.0.0.1; Docker compose should use host.docker.internal.
INDOOR_MAP_UPSTREAM=http://127.0.0.1:7801
INDOOR_MAP_API_UPSTREAM=http://127.0.0.1:3001
VITE_INDOOR_MAP_URL=/indoor-map/airport-map.html
VITE_INDOOR_MAP_API_BASE=/indoor-map-api
VITE_INDOOR_MAP_TILE_URL=
VITE_INDOOR_MAP_SAME_ORIGIN=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5174
ROUTE_SITE_DEFAULT_TENANT=airchina
VITE_LOCAL_AIRPORT_MAP=0

# ─── Security ──────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to POST tourist-position (CORS).
# Empty = same-origin only. '*' = open (kiosk only).
TOURIST_ALLOWED_ORIGINS=

# ─── Passenger Registry (SQLite) ─────────────────────────────────────────────
# Path to the SQLite database for the passenger registry.
# The parent directory must be writable. For production, use an absolute path.
# For PostgreSQL (Air China cloud), replace with DATABASE_URL (Phase 2).
DB_PATH=./data/passengers.db
